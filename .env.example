# BehaviorIQ ML Service — Environment Variables
# Copy this file to .env and fill in the values

# Loki log push endpoint
LOKI_URL=http://localhost:3100/loki/api/v1/push

# Environment label attached to every log line in Loki
APP_ENV=hackathon

# Remote Pinecone + Hugging Face (required for cloud hybrid search)
PINECONE_API=your_pinecone_api_key
HF_API_KEY=your_huggingface_api_key


# RAG Chat LLM Configuration
# LLM provider for the AI Commerce Assistant ("claude", "openai", or "gemini")
LLM_PROVIDER=claude

# Claude API key (required if LLM_PROVIDER=claude)
# ANTHROPIC_API_KEY=your_claude_api_key

# OpenAI API key (required if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key

# Google API key (required if LLM_PROVIDER=gemini)
# GOOGLE_API_KEY=your_google_api_key

