# BehaviorIQ ML Service — Environment Variables
# Copy this file to .env and fill in the values

# Loki log push endpoint
LOKI_URL=http://localhost:3100/loki/api/v1/push

# Environment label attached to every log line in Loki
APP_ENV=hackathon

# Remote Pinecone + Hugging Face (required for cloud hybrid search)
PINECONE_API=your_pinecone_api_key
HF_API_KEY=your_huggingface_api_key

# Optional Pinecone index settings (defaults work for new projects)
# PINECONE_INDEX=behavioriq-products
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Shared product catalog (defaults to ../data/products.json from repo root)
# PRODUCT_CATALOG_PATH=/absolute/path/to/products.json
